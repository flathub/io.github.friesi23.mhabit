+// limitations under the License.
+
+import 'dart:io';
+
+import 'package:flutter/foundation.dart' show kIsWeb;
+
+/// Temporary diagnostics for the Linux startup hang in issue #727.
+abstract final class LinuxStartupTrace {
+  static final enabled =
+      !kIsWeb &&
+      Platform.isLinux &&
+      Platform.environment['MHABIT_STARTUP_TRACE'] == '1';
+  static String? _phase;
+  static bool _rootBuilt = false;
+
+  /// Writes synchronously, including before the app logger is available.
+  static void mark(String message) {
+    if (!enabled) return;
+    try {
+      stderr.writeln('[mhabit-startup] dart $message');
+    } on IOException {
+      // A closed diagnostic stream must not interrupt startup.
+    }
+  }
+
+  static void begin(String phase) {
+    if (!enabled) return;
+    _phase = phase;
+    mark('$phase begin');
+  }
+
+  static void returned() {
+    if (!enabled) return;
+    mark('$_phase returned');
+    _phase = null;
+  }
+
+  static void error(String source, Object error) {
+    if (!enabled || _phase == null) return;
+    mark('$_phase error source=$source type=${error.runtimeType}');
+  }
+
+  static void rootBuild() {
+    if (!enabled || _rootBuilt) return;
+    _rootBuilt = true;
+    mark('root-build');
+  }
+}
