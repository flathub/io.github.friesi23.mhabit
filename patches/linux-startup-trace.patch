diff --git a/linux/startup_trace.h b/linux/startup_trace.h
new file mode 100644
index 0000000..d0e1913
--- /dev/null
+++ b/linux/startup_trace.h
@@ -0,0 +1,19 @@
+#ifndef MHABIT_LINUX_STARTUP_TRACE_H_
+#define MHABIT_LINUX_STARTUP_TRACE_H_
+
+#include <cstdio>
+#include <glib.h>
+
+inline bool startup_trace_enabled() {
+  static const bool enabled = g_strcmp0(g_getenv("MHABIT_STARTUP_TRACE"), "1") == 0;
+  return enabled;
+}
+
+inline void startup_trace(const char* stage) {
+  if (startup_trace_enabled()) {
+    std::fprintf(stderr, "[mhabit-startup] native %s\n", stage);
+    std::fflush(stderr);
+  }
+}
+
+#endif  // MHABIT_LINUX_STARTUP_TRACE_H_
